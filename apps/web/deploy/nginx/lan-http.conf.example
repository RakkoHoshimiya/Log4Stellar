# Include inside the origin-host Nginx http context. Adjust the names, ports
# and certificate paths together with the gateway environment.
map $http_upgrade $log4stellar_connection {
    default upgrade;
    '' close;
}
map $http_host $log4stellar_host_allowed {
    default 0;
    notes.example.net:5443 1;
    "~^[0-9a-v]{52}\.preview\.notes\.example\.net:5443$" 1;
}
map $host $log4stellar_webview {
    default 0;
    "~^[0-9a-v]{52}\.preview\.notes\.example\.net$" 1;
}

server {
    listen 127.0.0.1:19443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 127.0.0.1:19443 ssl;
    http2 on;
    server_name notes.example.net "~^[0-9a-v]{52}\.preview\.notes\.example\.net$";
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /etc/log4stellar/tls/public.crt;
    ssl_certificate_key /etc/log4stellar/tls/public.key;
    access_log off;

    if ($log4stellar_host_allowed = 0) { return 421; }
    client_max_body_size 512m;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_vary on;
    gzip_types application/javascript text/javascript text/css application/json application/wasm image/svg+xml;

    proxy_ssl_server_name on;
    proxy_ssl_name log4stellar-origin.internal;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/log4stellar/tls/origin-ca.crt;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Connection $log4stellar_connection;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header X-Forwarded-Proto https;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 180s;

    location = /metrics { return 404; }
    location = /readyz { return 404; }
    location = /healthz { return 404; }

    location = /static/build/manifest.json {
        if ($log4stellar_webview = 1) { return 404; }
        default_type application/manifest+json;
        return 200 '{"name":"Log4Stellar","short_name":"Log4Stellar","start_url":"/","scope":"/","display":"standalone"}';
    }

    location /static/build/ {
        gzip on;
        proxy_pass https://127.0.0.1:8443;
    }

    location /static/extensions/ {
        if ($log4stellar_webview = 1) { return 404; }
        gzip on;
        proxy_pass https://127.0.0.1:8443;
    }

    location = / {
        if ($log4stellar_webview = 1) { return 404; }
        sub_filter_once on;
        sub_filter '</head>' '<link rel="modulepreload" href="/static/build/out/vs/workbench/workbench.web.main.internal.js"><style>#l4s-startup{position:fixed;inset:0;display:grid;place-content:center;text-align:center;gap:12px;background:#161616;color:#ddd;font:15px system-ui,sans-serif}body:has(.monaco-workbench) #l4s-startup{display:none}</style></head>';
        sub_filter '<body aria-label="">' '<body aria-label=""><div id="l4s-startup" role="status"><strong>Log4Stellar</strong><span>Loading workbench…</span><progress aria-label="Loading Log4Stellar"></progress></div>';
        proxy_pass https://127.0.0.1:8443;
    }

    location / {
        if ($log4stellar_webview = 1) { return 404; }
        proxy_pass https://127.0.0.1:8443;
    }
}
