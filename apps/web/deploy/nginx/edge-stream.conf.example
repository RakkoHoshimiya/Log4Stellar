# Include inside the cloud Nginx or OpenResty stream context.
# The SSH remote forward listens only on this host's loopback address.
limit_conn_zone $binary_remote_addr zone=log4stellar_edge_ip:1m;
server {
    listen 0.0.0.0:5443;
    limit_conn log4stellar_edge_ip 36;
    proxy_connect_timeout 5s;
    proxy_timeout 300s;
    proxy_pass 127.0.0.1:15443;
}
