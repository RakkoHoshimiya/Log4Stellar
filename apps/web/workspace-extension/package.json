{
  "name": "workspace-files",
  "displayName": "%workspace.displayName%",
  "publisher": "log4stellar",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "browser": "./extension.js",
  "activationEvents": [
    "onFileSystem:vscode-test-web",
    "onSearch:vscode-test-web",
    "onCommand:log4stellar.workspace.git",
    "onCommand:log4stellar.workspace.upload",
    "onCommand:log4stellar.workspace.advancedSearch",
    "onCommand:log4stellar.workspace.preview",
    "onCommand:log4stellar.workspace.previewVersion",
    "onCustomEditor:log4stellar.officePreview",
    "onView:log4stellar.knowledge",
    "onCommand:log4stellar.workspace.tenants"
  ],
  "enabledApiProposals": [
    "fileSearchProvider",
    "textSearchProvider"
  ],
  "contributes": {
    "resourceLabelFormatters": [
      {
        "scheme": "vscode-test-web",
        "formatting": {
          "label": "${path}",
          "separator": "/"
        }
      }
    ],
    "commands": [
      {
        "command": "log4stellar.workspace.advancedSearch",
        "title": "%workspace.advancedSearch%",
        "category": "Log4Stellar"
      },
      {
        "command": "log4stellar.workspace.upload",
        "title": "%workspace.upload%",
        "category": "Log4Stellar",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "log4stellar.workspace.git",
        "title": "Git",
        "category": "Log4Stellar",
        "icon": "$(git-branch)"
      },
      {
        "command": "log4stellar.workspace.preview",
        "title": "%workspace.preview%",
        "category": "Log4Stellar",
        "icon": "$(open-preview)"
      },
      {
        "command": "log4stellar.workspace.previewVersion",
        "title": "%workspace.previewVersion%",
        "category": "Log4Stellar",
        "icon": "$(history)"
      },
      {
        "command": "log4stellar.knowledge.refresh",
        "title": "%knowledge.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "log4stellar.knowledge.reindex",
        "title": "%knowledge.reindex%",
        "icon": "$(database)"
      },
      {
        "command": "log4stellar.workspace.tenants",
        "title": "%workspace.tenants%",
        "category": "Log4Stellar",
        "icon": "$(organization)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "log4stellar.workspace.upload",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@99"
        },
        {
          "command": "log4stellar.workspace.git",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@100"
        },
        {
          "command": "log4stellar.knowledge.refresh",
          "when": "view == log4stellar.knowledge",
          "group": "navigation"
        },
        {
          "command": "log4stellar.knowledge.reindex",
          "when": "view == log4stellar.knowledge"
        },
        {
          "command": "log4stellar.workspace.tenants",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@101"
        }
      ],
      "explorer/context": [
        {
          "command": "log4stellar.workspace.upload",
          "when": "explorerResourceIsFolder && resourceScheme == vscode-test-web",
          "group": "navigation@22"
        },
        {
          "command": "log4stellar.workspace.preview",
          "when": "resourceScheme == vscode-test-web && resourceExtname =~ /^\\.(docx|xlsx|pptx)$/",
          "group": "navigation@20"
        },
        {
          "command": "log4stellar.workspace.previewVersion",
          "when": "resourceScheme == vscode-test-web && resourceExtname =~ /^\\.(docx|xlsx|pptx)$/",
          "group": "navigation@21"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "log4stellar.officePreview",
        "displayName": "%workspace.officeEditor%",
        "selector": [
          {
            "filenamePattern": "*.[dD][oO][cC][xX]"
          },
          {
            "filenamePattern": "*.[xX][lL][sS][xX]"
          },
          {
            "filenamePattern": "*.[pP][pP][tT][xX]"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "log4stellarKnowledge",
          "title": "%knowledge.title%",
          "icon": "$(references)"
        }
      ]
    },
    "views": {
      "log4stellarKnowledge": [
        {
          "id": "log4stellar.knowledge",
          "name": "%knowledge.title%"
        }
      ]
    }
  }
}
